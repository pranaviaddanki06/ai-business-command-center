{
  "cleanUrls": true,
  "redirects": [{ "source": "/", "destination": "/pulse-final.html", "permanent": false }],
  "rewrites": [{ "source": "/pulse", "destination": "/pulse-final.html" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
  }]
}